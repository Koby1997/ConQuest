# Copy this file to .env (which is git-ignored) and fill in your own values.
# They only seed a brand-new database; after that, change them in the Settings tab.

# Where drive times are measured from.
CONQUEST_HOME_LABEL=Orlando, FL
CONQUEST_HOME_LAT=28.5384
CONQUEST_HOME_LNG=-81.3789

# Optional: keep the database somewhere other than ./data
# CONQUEST_DATA_DIR=C:\path\to\conquest-data
